<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>The Winner School Attendance</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#f2f5fa;color:#18253a;font:16px system-ui}button,input,select{font:inherit}button{border:0;border-radius:9px;background:#2563eb;color:#fff;padding:10px 13px;font-weight:650}button.secondary{background:#e6edf7;color:#183453}button.red{background:#dc2626}.hidden{display:none!important}.login{max-width:440px;margin:8vh auto;background:#fff;padding:25px;border-radius:18px;box-shadow:0 8px 30px #0001}.brand{text-align:center;color:#173251}.brand .ico{font-size:40px}.brand h1{font-size:22px;margin:5px}.brand p{margin:0 0 20px;color:#64748b}label{display:block;font-size:13px;font-weight:650;margin:12px 0 5px}input,select{width:100%;padding:10px;border:1px solid #dbe3ee;border-radius:9px;background:#fff}.login button{width:100%;margin-top:15px}.demo{font-size:13px;background:#f7f9fc;padding:12px;border-radius:10px;margin-top:15px;color:#475569}.top{background:#173251;color:#fff;padding:14px;display:flex;justify-content:space-between;align-items:center;gap:8px;position:sticky;top:0}.top h2{font-size:17px;margin:0}.top small{opacity:.8}.wrap{max-width:1050px;margin:auto;padding:13px}.tabs{display:flex;gap:7px;overflow:auto;margin-bottom:12px}.tabs button{background:#fff;color:#173251;border:1px solid #dbe3ee;white-space:nowrap}.tabs button.active{background:#2563eb;color:white}.card{background:white;border:1px solid #e0e7f0;border-radius:14px;padding:14px;margin-bottom:12px}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.stat{font-size:25px;font-weight:800}.muted{font-size:13px;color:#64748b}.toolbar{display:flex;gap:8px;align-items:end;flex-wrap:wrap}.toolbar>div{flex:1;min-width:130px}.tablewrap{overflow:auto}table{border-collapse:collapse;width:100%;min-width:520px}th,td{padding:9px;border-bottom:1px solid #e5eaf1;text-align:left;font-size:14px}th{background:#f8fafc;font-size:12px;color:#526176}.formgrid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.controls{display:flex;gap:5px}.controls button{padding:6px 8px;font-size:12px}.notice{background:#fff7ed;border:1px solid #fed7aa;padding:11px;border-radius:9px;color:#9a3412;font-size:13px}.foot{font-size:12px;color:#64748b;padding:8px}.empty{padding:20px;text-align:center;color:#64748b}@media(max-width:650px){.grid{grid-template-columns:1fr 1fr}.wrap{padding:9px}.top h2{font-size:15px}.formgrid{grid-template-columns:1fr}}
</style></head><body>
<section id="loginScreen" class="login"><div class="brand"><div class="ico">🏫</div><h1>THE WINNER SCHOOL</h1><p>Islamic Campus · Attendance System</p></div><label>Login ID</label><input id="loginId" placeholder="Login ID"><label>Password</label><input id="loginPass" type="password" placeholder="Password"><button onclick="login()">Sign In</button><div class="demo"><b>Demo accounts</b><br>Admin: <b>admin</b> / <b>admin123</b><br>Staff: <b>teacher</b> / <b>teacher123</b><br><small>Prototype only: data is stored in this browser/device. Firebase is not connected.</small></div></section>
<section id="app" class="hidden"><header class="top"><div><h2>THE WINNER SCHOOL</h2><small>Islamic Campus · Attendance</small></div><div><span id="badge"></span> <button class="secondary" onclick="logout()">Logout</button></div></header><main class="wrap"><nav class="tabs" id="tabs"></nav><div id="content"></div><div class="foot">Prototype only · Local device storage · Firebase cloud/security setup is required before real school use.</div></main></section>
<script>
const K='winnerSchoolPrototype';let D=JSON.parse(localStorage.getItem(K)||'null')||{students:[],staff:[{id:'teacher',name:'Demo Teacher',pass:'teacher123',classes:['Class 1']}],classes:['Nursery','Prep','Class 1','Class 2','Class 3','Class 4','Class 5'],records:{},holidays:[]},U=null,T='Dashboard';const save=()=>localStorage.setItem(K,JSON.stringify(D));function today(){let x=new Date();return new Date(x.getTime()-x.getTimezoneOffset()*60000).toISOString().slice(0,10)}function esc(x){return String(x||'').replace(/[&<>"']/g,a=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[a]))}function login(){let id=loginId.value.trim(),pw=loginPass.value;if(id==='admin'&&pw==='admin123')U={role:'Admin',name:'Administrator',classes:D.classes};else{let s=D.staff.find(a=>a.id===id&&a.pass===pw);if(s)U={role:'Staff',name:s.name,classes:s.classes}}if(!U)return alert('Login ID/password incorrect');loginScreen.classList.add('hidden');app.classList.remove('hidden');badge.textContent=U.role+' · '+U.name;renderTabs();show('Dashboard')}function logout(){U=null;app.classList.add('hidden');loginScreen.classList.remove('hidden');loginPass.value=''}function allowed(){return U.role==='Admin'?['Dashboard','Attendance','Students','Reports','Staff','Holidays','Backup']:['Dashboard','Attendance','Reports']}function renderTabs(){tabs.innerHTML=allowed().map(x=>`<button class="${T===x?'active':''}" onclick="show('${x}')">${x}</button>`).join('')}function show(x){T=x;renderTabs();({Dashboard:dashboard,Attendance:attendance,Students:students,Reports:reports,Staff:staff,Holidays:holidayPage,Backup:backupPage}[x]||dashboard)()}function opts(list){return list.map(x=>`<option>${esc(x)}</option>`).join('')}function getrec(d,c){return D.records[d]?.[c]||{}}
function dashboard(){let all=U.classes.flatMap(c=>D.students.filter(s=>s.cls===c)),r=U.classes.flatMap(c=>Object.values(getrec(today(),c)));content.innerHTML=`<div class="grid"><div class="card"><div class="muted">Students</div><div class="stat">${all.length}</div></div><div class="card"><div class="muted">Present today</div><div class="stat">${r.filter(x=>x==='P').length}</div></div><div class="card"><div class="muted">Absent today</div><div class="stat">${r.filter(x=>x==='A').length}</div></div><div class="card"><div class="muted">Leave today</div><div class="stat">${r.filter(x=>x==='L').length}</div></div></div><div class="card"><h3>Welcome, ${esc(U.name)}</h3><p class="muted">${U.role==='Admin'?'Administrator access':'Assigned classes: '+U.classes.join(', ')}</p><button onclick="show('Attendance')">Mark Attendance</button></div>`}
function attendance(){content.innerHTML=`<div class="card"><h3>Daily Attendance</h3><div class="toolbar"><div><label>Date</label><input id="adate" type="date" value="${today()}" onchange="drawAttendance()"></div><div><label>Class</label><select id="aclass" onchange="drawAttendance()">${opts(U.classes)}</select></div></div><div id="attlist"></div><button onclick="saveAtt()">Save Attendance</button> <button class="secondary" onclick="waAbsent()">WhatsApp Absentees</button></div>`;drawAttendance()}function drawAttendance(){let d=adate.value,c=aclass.value,ss=D.students.filter(s=>s.cls===c),r=getrec(d,c);attlist.innerHTML=ss.length?`<div class="tablewrap"><table><tr><th>Student</th><th>Roll</th><th>Status</th></tr>${ss.map(s=>{let st=r[s.id]||'P';return `<tr><td>${esc(s.name)}</td><td>${esc(s.roll)}</td><td><div class="controls"><button style="background:#16a34a" onclick="setst('${s.id}','P')">P</button><button style="background:#dc2626" onclick="setst('${s.id}','A')">A</button><button style="background:#d97706" onclick="setst('${s.id}','L')">L</button><b>${st}</b></div></td></tr>`}).join('')}</table></div>`:'<div class="empty">No students in this class. Admin add students first.</div>'}function setst(id,s){let d=adate.value,c=aclass.value;D.records[d]??={};D.records[d][c]??={};D.records[d][c][id]=s;drawAttendance()}function saveAtt(){save();alert('Attendance saved on this device.')}function waAbsent(){let c=aclass.value,d=adate.value,ss=D.students.filter(s=>s.cls===c),r=getrec(d,c),abs=ss.filter(s=>r[s.id]==='A'&&s.phone);if(!abs.length)return alert('No absent students with phone numbers.');let msg=encodeURIComponent(`Assalam-o-Alaikum Dear Parent, your child is marked ABSENT today (${d}). Regards, The Winner School (Islamic Campus).`);abs.forEach((s,i)=>setTimeout(()=>window.open('https://wa.me/'+s.phone.replace(/\D/g,'')+'?text='+msg,'_blank'),i*400))}
function students(){content.innerHTML=`<div class="card"><h3>Student Register</h3><div class="formgrid"><div><label>Name</label><input id="sn"></div><div><label>Roll No.</label><input id="sr"></div><div><label>Class</label><select id="sc">${opts(D.classes)}</select></div><div><label>Parent WhatsApp</label><input id="sp" placeholder="923xxxxxxxxx"></div></div><button style="margin-top:12px" onclick="addStudent()">Add Student</button></div><div class="card"><h3>Student List (${D.students.length})</h3><div class="tablewrap"><table><tr><th>Name</th><th>Roll</th><th>Class</th><th>Parent phone</th><th></th></tr>${D.students.map(s=>`<tr><td>${esc(s.name)}</td><td>${esc(s.roll)}</td><td>${esc(s.cls)}</td><td>${esc(s.phone)}</td><td><button class="red" onclick="delStudent('${s.id}')">Delete</button></td></tr>`).join('')}</table></div><button class="secondary" onclick="exportStudents()">Export CSV</button></div>`}function addStudent(){if(!sn.value.trim())return alert('Student name required');D.students.push({id:'stu'+Date.now(),name:sn.value.trim(),roll:sr.value.trim(),cls:sc.value,phone:sp.value.trim()});save();students()}function delStudent(id){if(confirm('Delete student?')){D.students=D.students.filter(s=>s.id!==id);save();students()}}
function reports(){content.innerHTML=`<div class="card"><h3>Daily Report</h3><div class="toolbar"><div><label>Date</label><input type="date" id="rd" value="${today()}"></div><div><label>Class</label><select id="rc">${opts(U.classes)}</select></div><button onclick="daily()">Generate</button></div><div id="dailyout"></div></div><div class="card"><h3>Monthly Report</h3><div class="toolbar"><div><label>Month</label><input type="month" id="rm" value="${today().slice(0,7)}"></div><div><label>Class</label><select id="rcl">${opts(U.classes)}</select></div><button onclick="monthly()">Generate</button></div><div id="monthout"></div></div>`}function daily(){let d=rd.value,c=rc.value,ss=D.students.filter(s=>s.cls===c),r=getrec(d,c),p=0,a=0,l=0;ss.forEach(s=>{let z=r[s.id]||'P';if(z==='P')p++;if(z==='A')a++;if(z==='L')l++});dailyout.innerHTML=`<p><b>${c} · ${d}</b></p>Present: ${p} · Absent: ${a} · Leave: ${l} · Total: ${ss.length}<p><button class="secondary" onclick="exportDay('${d}','${c}')">Export CSV</button></p>`}function exportDay(d,c){let ss=D.students.filter(s=>s.cls===c),r=getrec(d,c);csv('daily-'+d+'.csv',['Date','Class','Student','Roll','Status'],ss.map(s=>[d,c,s.name,s.roll,r[s.id]||'P']))}function monthly(){let m=rm.value,c=rcl.value,ss=D.students.filter(s=>s.cls===c),dates=Object.keys(D.records).filter(d=>d.startsWith(m));let rows=ss.map(s=>{let p=0,a=0,l=0;dates.forEach(d=>{let z=getrec(d,c)[s.id]||'P';if(z==='P')p++;else if(z==='A')a++;else l++});let total=p+a+l;return[s.name,s.roll,p,a,l,total?Math.round(p/total*100):0]});monthout.innerHTML=`<div class="tablewrap"><table><tr><th>Student</th><th>Roll</th><th>P</th><th>A</th><th>L</th><th>%</th></tr>${rows.map(r=>`<tr>${r.map(x=>`<td>${x}</td>`).join('')}</tr>`).join('')}</table></div><button class="secondary" onclick="csv('monthly-${m}.csv',['Student','Roll','Present','Absent','Leave','Percent'],${JSON.stringify(rows)})">Export CSV</button>`}
function staff(){content.innerHTML=`<div class="card"><h3>Create Staff Login</h3><div class="formgrid"><div><label>Name</label><input id="tn"></div><div><label>Login ID</label><input id="ti"></div><div><label>Password</label><input id="tp"></div><div><label>Assigned class</label><select id="tc">${opts(D.classes)}</select></div></div><button style="margin-top:12px" onclick="addStaff()">Create Staff</button></div><div class="card"><h3>Staff list</h3><table><tr><th>Name</th><th>ID</th><th>Assigned classes</th><th></th></tr>${D.staff.map(s=>`<tr><td>${esc(s.name)}</td><td>${esc(s.id)}</td><td>${esc(s.classes.join(', '))}</td><td><button class="red" onclick="removeStaff('${s.id}')">Delete</button></td></tr>`).join('')}</table></div><div class="notice">Prototype accounts are not secure. Real Firebase authentication/rules will be added before actual deployment.</div>`}function addStaff(){if(!tn.value||!ti.value||!tp.value)return alert('Fill all fields');if(D.staff.some(s=>s.id===ti.value)||ti.value==='admin')return alert('Login ID already exists');D.staff.push({id:ti.value,name:tn.value,pass:tp.value,classes:[tc.value]});save();staff()}function removeStaff(id){if(confirm('Remove staff account?')){D.staff=D.staff.filter(s=>s.id!==id);save();staff()}}
function holidayPage(){content.innerHTML=`<div class="card"><h3>Holiday List</h3><div class="toolbar"><div><label>Date</label><input type="date" id="hd"></div><div><label>Holiday</label><input id="hn"></div><button onclick="addHoliday()">Add</button></div><ul>${D.holidays.map(h=>`<li>${h.date} — ${esc(h.name)} <button class="red" onclick="removeHoliday('${h.date}')">Remove</button></li>`).join('')}</ul><p class="muted">Prototype: holiday list does not yet automatically prevent attendance.</p></div>`}function addHoliday(){if(!hd.value||!hn.value)return alert('Date and name required');D.holidays.push({date:hd.value,name:hn.value});save();holidayPage()}function removeHoliday(d){D.holidays=D.holidays.filter(h=>h.date!==d);save();holidayPage()}
function backupPage(){content.innerHTML=`<div class="card"><h3>Backup & Restore</h3><button onclick="backup()">Download Backup JSON</button><label>Restore backup</label><input type="file" id="bf" accept="application/json"><button class="secondary" onclick="restore()">Restore File</button><p class="muted">Keep backup file private.</p></div>`}function backup(){let a=document.createElement('a'),b=new Blob([JSON.stringify(D,null,2)],{type:'application/json'});a.href=URL.createObjectURL(b);a.download='winner-school-backup.json';a.click()}function restore(){let f=bf.files[0];if(!f)return alert('Choose backup file');let reader=new FileReader();reader.onload=()=>{try{D=JSON.parse(reader.result);save();show('Dashboard');alert('Backup restored')}catch(e){alert('Invalid file')}};reader.readAsText(f)}function exportStudents(){csv('students.csv',['Name','Roll','Class','Parent phone'],D.students.map(s=>[s.name,s.roll,s.cls,s.phone]))}function csv(file,head,rows){let txt=[head,...rows].map(row=>row.map(v=>'"'+String(v??'').replace(/"/g,'""')+'"').join(',')).join('\r\n'),blob=new Blob([txt],{type:'text/csv'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=file;a.click()}
</script></body></html>
